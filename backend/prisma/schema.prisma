// Models implement DATABASE.md and are added one step at a time through Prisma Migrate
// migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformUserKind {
  super_admin
  platform_admin

  @@map("platform_user_kind")
}

enum UserStatus {
  active
  deactivated

  @@map("user_status")
}

// DATABASE.md 4.1. Platform table: not tenant-owned, so no business_id and no RLS.
// The password hash lives in platform_accounts (DATABASE.md 4.8), never on this table.
model PlatformUser {
  id                      String           @id @db.Uuid // generated by the application (DQ-1)
  email                   String           @unique @db.Citext
  emailVerified           Boolean          @default(false) @map("email_verified") // required by Better Auth
  fullName                String           @map("full_name")
  kind                    PlatformUserKind
  status                  UserStatus       @default(active)
  failedLoginCount        Int              @default(0) @map("failed_login_count")
  lockedUntil             DateTime?        @map("locked_until") @db.Timestamptz(6)
  lastLoginAt             DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdById             String?          @map("created_by") @db.Uuid
  createdBy               PlatformUser?    @relation("PlatformUserCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers            PlatformUser[]   @relation("PlatformUserCreator")
  statusChangedBusinesses Business[]
  sessions                PlatformSession[]
  accounts                PlatformAccount[]
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_users")
}

enum BusinessStatus {
  active
  suspended

  @@map("business_status")
}

// DATABASE.md 4.2. The tenant itself: its policy is on id, not business_id.
// status_reason being required when suspended is a service rule, not a database check.
model Business {
  id                String         @id @db.Uuid // generated by the application (DQ-1)
  name              String
  status            BusinessStatus @default(active)
  statusReason      String?        @map("status_reason")
  statusChangedById String?        @map("status_changed_by") @db.Uuid
  statusChangedBy   PlatformUser?  @relation(fields: [statusChangedById], references: [id], onDelete: Restrict)
  currencyCode      String         @map("currency_code") @db.Char(3)
  locale            String
  timeZone          String         @map("time_zone")
  nearExpiryDays    Int            @map("near_expiry_days") // no default (OQ-28)
  invoiceName       String?        @map("invoice_name")
  address           String?
  phone             String?
  taxRegistrationNo String?        @map("tax_registration_no")
  logoStorageKey    String?        @map("logo_storage_key")
  version           Int
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("businesses")
}

// DATABASE.md 4.8. Platform realm authentication tables used by Better Auth. The tenant
// realm equivalents (sessions, accounts, verifications) arrive with the users migration.
// Models use Better Auth's field names; columns are snake_case.

// Server-side session. The token is stored as issued; the cookie carries it HMAC-signed.
// Revocation deletes the row. absolute_expires_at is never extended (application check).
model PlatformSession {
  id                String       @id @db.Uuid // generated by the application (DQ-1)
  token             String       @unique
  userId            String       @map("user_id") @db.Uuid
  user              PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  expiresAt         DateTime     @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(6)
  ipAddress         String?      @map("ip_address") @db.Inet
  userAgent         String?      @map("user_agent")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

// Sign-in credential. password is an argon2id hash only: never logged, audited or returned.
model PlatformAccount {
  id         String       @id @db.Uuid // generated by the application (DQ-1)
  userId     String       @map("user_id") @db.Uuid
  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  providerId String       @map("provider_id") // always "credential" in the MVP
  accountId  String       @map("account_id")
  password   String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("platform_accounts")
}

// Single-use, expiring tokens for password reset (used by the reset flow, not by sign-in).
model PlatformVerification {
  id         String   @id @db.Uuid // generated by the application (DQ-1)
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_verifications")
}
