# Copy to .env and replace placeholders. Never commit .env.
# Names only here: no real values belong in this file.

# --- Backend ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
# Comma-separated explicit origins. No wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Secret. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:replace-with-a-local-password@localhost:5432/pharma

# Secret: at least 32 random characters. Signs session cookies.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Optional overrides (defaults shown).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_SIGN_IN_PER_MINUTE=5

# --- Local services (docker-compose.yml, development only) ---
POSTGRES_USER=pharma
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=pharma_erp
